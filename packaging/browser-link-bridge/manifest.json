{
  "manifest_version": 3,
  "name": "Sange · SoundCloud links",
  "version": "2.0.0",
  "description": "Open SoundCloud links in the Sange desktop application.",
  "permissions": ["activeTab"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["links.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "action": {
    "default_title": "Открыть в Sange",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {"id": "soundcloud-links@scrip.app", "strict_min_version": "109.0"}
  }
}
