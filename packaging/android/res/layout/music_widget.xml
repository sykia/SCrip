<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToOutline="true"
    android:background="@drawable/widget_bg_dark">
    <ImageView android:id="@+id/widget_blur_cover" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:visibility="gone" android:contentDescription="@null" />
    <ImageView android:id="@+id/widget_scrim" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_blur_scrim" android:scaleType="fitXY" android:visibility="gone" android:importantForAccessibility="no" />
    <LinearLayout android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <LinearLayout android:id="@+id/widget_info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="42dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_cover" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="centerCrop" android:src="@drawable/icon" android:contentDescription="Обложка трека" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginLeft="10dp" android:layout_marginRight="6dp" android:orientation="vertical" android:gravity="center_vertical">
                <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SCrip" android:textColor="#fffaf9" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
                <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Включи музыку в приложении" android:textColor="#c8c3c5" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" />
            </LinearLayout>
            <ImageButton android:id="@+id/widget_play_blur" android:layout_width="48dp" android:layout_height="48dp" android:padding="13dp" android:background="@drawable/widget_play_button" android:src="@drawable/widget_play" android:scaleType="fitCenter" android:visibility="gone" android:contentDescription="Воспроизвести" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_progress_row" android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/widget_elapsed" android:layout_width="36dp" android:layout_height="wrap_content" android:text="0:00" android:textColor="#cbc6c9" android:textSize="10sp" android:includeFontPadding="false" />
            <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="3dp" android:progressDrawable="@drawable/widget_progress" android:indeterminate="false" android:max="1000" />
            <TextView android:id="@+id/widget_remaining" android:layout_width="38dp" android:layout_height="wrap_content" android:gravity="right" android:text="−0:00" android:textColor="#cbc6c9" android:textSize="10sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_blur_controls" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
            <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_previous" android:tint="#f7f4f6" android:scaleType="fitCenter" android:contentDescription="Предыдущий трек" />
            <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_next" android:tint="#f7f4f6" android:scaleType="fitCenter" android:contentDescription="Следующий трек" />
            <ImageButton android:id="@+id/widget_like" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="11dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_heart" android:scaleType="fitCenter" android:contentDescription="Добавить в понравившиеся" />
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_card_controls" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:visibility="visible">
            <ImageButton android:id="@+id/widget_previous_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_previous" android:tint="#f7f4f6" android:scaleType="fitCenter" android:contentDescription="Предыдущий трек" />
            <ImageButton android:id="@+id/widget_play_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="10dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_play" android:tint="#f7f4f6" android:scaleType="fitCenter" android:contentDescription="Воспроизвести" />
            <ImageButton android:id="@+id/widget_next_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="12dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_next" android:tint="#f7f4f6" android:scaleType="fitCenter" android:contentDescription="Следующий трек" />
            <ImageButton android:id="@+id/widget_like_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:padding="11dp" android:background="@drawable/widget_touch" android:src="@drawable/widget_heart" android:scaleType="fitCenter" android:contentDescription="Добавить в понравившиеся" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
