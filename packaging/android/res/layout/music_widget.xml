<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_blur_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_blur_scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Shared compact and Dark/Blur header. Light expands into its own album-led layout. -->
        <LinearLayout
            android:id="@+id/widget_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/widget_cover"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="Обложка трека"
                android:scaleType="centerCrop"
                android:src="@drawable/icon" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="SCrip"
                    android:textColor="#fffaf9"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Включи музыку в приложении"
                    android:textColor="#c8c3c5"
                    android:textSize="12sp" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/widget_play_blur"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/widget_play_button"
                android:contentDescription="Воспроизвести"
                android:padding="17dp"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_play"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Wide Light Card places the album first and groups metadata with controls. -->
        <LinearLayout
            android:id="@+id/widget_light_info"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:minHeight="108dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageView
                android:id="@+id/widget_cover_light"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_marginRight="12dp"
                android:contentDescription="Обложка трека"
                android:scaleType="centerCrop"
                android:src="@drawable/icon" />
            <LinearLayout
                android:id="@+id/widget_light_info_click"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/widget_title_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:text="SCrip"
                    android:textColor="#242126"
                    android:textSize="17sp" />
                <TextView
                    android:id="@+id/widget_artist_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Исполнитель"
                    android:textColor="#77737a"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="22dp"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView android:id="@+id/widget_elapsed_light" android:layout_width="31dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="0:00" android:textColor="#77737a" android:textSize="10sp" />
                    <ProgressBar android:id="@+id/widget_progress_light" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:indeterminate="false" android:max="1000" android:progressDrawable="@drawable/widget_progress" />
                    <TextView android:id="@+id/widget_remaining_light" android:layout_width="34dp" android:layout_height="wrap_content" android:gravity="right" android:includeFontPadding="false" android:text="−0:00" android:textColor="#77737a" android:textSize="10sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageButton android:id="@+id/widget_previous_light" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Предыдущий трек" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/widget_previous" android:tint="#302a2d" />
                    <ImageButton android:id="@+id/widget_play_light" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_play_button_light" android:contentDescription="Воспроизвести" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_play" android:tint="#fffaf9" />
                    <ImageButton android:id="@+id/widget_next_light" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Следующий трек" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/widget_next" android:tint="#302a2d" />
                    <ImageButton android:id="@+id/widget_like_light" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Добавить в понравившиеся" android:padding="10dp" android:scaleType="fitCenter" android:src="@drawable/widget_heart" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_progress_row"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_elapsed" android:layout_width="38dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="0:00" android:textColor="#cbc6c9" android:textSize="11sp" />
            <ProgressBar android:id="@+id/widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:indeterminate="false" android:max="1000" android:progressDrawable="@drawable/widget_progress" />
            <TextView android:id="@+id/widget_remaining" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:includeFontPadding="false" android:text="−0:00" android:textColor="#cbc6c9" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_blur_controls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <ImageButton android:id="@+id/widget_previous" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Предыдущий трек" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_previous" android:tint="#f7f4f6" />
            <ImageButton android:id="@+id/widget_next" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Следующий трек" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_next" android:tint="#f7f4f6" />
            <ImageButton android:id="@+id/widget_like" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Добавить в понравившиеся" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/widget_heart" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_card_controls"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="visible">
            <ImageButton android:id="@+id/widget_previous_card" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Предыдущий трек" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_previous" android:tint="#f7f4f6" />
            <ImageButton android:id="@+id/widget_play_card" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/widget_play_button" android:contentDescription="Воспроизвести" android:padding="15dp" android:scaleType="fitCenter" android:src="@drawable/widget_play" android:tint="#302a2d" />
            <ImageButton android:id="@+id/widget_next_card" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Следующий трек" android:padding="12dp" android:scaleType="fitCenter" android:src="@drawable/widget_next" android:tint="#f7f4f6" />
            <ImageButton android:id="@+id/widget_like_card" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/widget_touch" android:contentDescription="Добавить в понравившиеся" android:padding="11dp" android:scaleType="fitCenter" android:src="@drawable/widget_heart" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_card_progress_row"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView android:id="@+id/widget_elapsed_card" android:layout_width="38dp" android:layout_height="wrap_content" android:includeFontPadding="false" android:text="0:00" android:textColor="#c8c3c8" android:textSize="11sp" />
            <ProgressBar android:id="@+id/widget_progress_card" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:indeterminate="false" android:max="1000" android:progressDrawable="@drawable/widget_progress" />
            <TextView android:id="@+id/widget_remaining_card" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:includeFontPadding="false" android:text="−0:00" android:textColor="#c8c3c8" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
