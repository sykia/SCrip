pkgname=scrip
pkgver=1.6.1
pkgrel=1
license=('GPL-3.0-only')
pkgdesc='Настольный плеер для SoundCloud'
# Для каждого выпуска обновляйте версию и SHA-256 архива исходников.
arch=('x86_64')
url='https://github.com/sykia/SCrip'
depends=('libsecret' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-multimedia-ffmpeg')
makedepends=('cmake' 'ninja')
source=("$url/releases/download/v$pkgver/SCrip-$pkgver-source.tar.gz")
sha256sums=('acff5a808e78aed6ddda17e0ca2b61989495e054bbdc6e26ae1116a3b9d26c1a')
build() {
    cmake -S "SCrip-$pkgver" -B build -G Ninja -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release
    cmake --build build --parallel 2
}
package() {
    install -Dm644 "SCrip-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/scrip/LICENSE"
    install -Dm644 "SCrip-$pkgver/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/doc/scrip/THIRD_PARTY_NOTICES.md"
    install -Dm644 "SCrip-$pkgver/TRADEMARKS.md" "$pkgdir/usr/share/doc/scrip/TRADEMARKS.md"
    install -Dm755 build/scrip "$pkgdir/usr/bin/scrip"
    install -Dm644 "SCrip-$pkgver/packaging/linux/scrip.desktop" "$pkgdir/usr/share/applications/scrip.desktop"
    install -Dm644 "SCrip-$pkgver/packaging/linux/scrip.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/scrip.png"
}
