pkgname=scrip
pkgver=2.2.0
pkgrel=1
license=('GPL-3.0-only')
pkgdesc='Настольный плеер для SoundCloud'
# Для каждого выпуска обновляйте версию и SHA-256 архива исходников.
arch=('x86_64')
url='https://github.com/sykia/sange'
depends=('libsecret' 'qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-multimedia-ffmpeg' 'kwindowsystem' 'libxcb')
makedepends=('cmake' 'ninja')
source=("$url/releases/download/v$pkgver/Sange-$pkgver-source.tar.gz")
sha256sums=('d2b027917d7c2efa93d56cb1f3da2a63137d69ab1f1db42c24a54212f6ce5e47')
build() {
    cmake -S "Sange-$pkgver" -B build -G Ninja -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release
    cmake --build build --parallel 2
}
package() {
    install -Dm644 "Sange-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/scrip/LICENSE"
    install -Dm644 "Sange-$pkgver/THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/doc/scrip/THIRD_PARTY_NOTICES.md"
    install -Dm644 "Sange-$pkgver/TRADEMARKS.md" "$pkgdir/usr/share/doc/scrip/TRADEMARKS.md"
    install -Dm755 build/sange "$pkgdir/usr/bin/sange"
    install -Dm644 "Sange-$pkgver/packaging/linux/scrip.desktop" "$pkgdir/usr/share/applications/Sange.desktop"
    install -Dm644 "Sange-$pkgver/packaging/linux/scrip.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/scrip.png"
}
