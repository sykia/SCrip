{
  "api": 2,
  "kind": "declarative",
  "id": "discovery",
  "name": "Маршруты поиска",
  "version": "1.0.0",
  "requiresHost": {
    "min": "0.0.0",
    "maxExclusive": "65535.65535.65535"
  },
  "permissions": [
    "ui.panels",
    "navigation"
  ],
  "settings": [
    {
      "id": "legacy-group-0",
      "type": "boolean",
      "label": "Найти музыку",
      "default": true
    }
  ],
  "contributions": [
    {
      "id": "legacy-panel-0",
      "type": "panel",
      "slot": "home.panels",
      "title": "Найти музыку",
      "enabledSetting": "legacy-group-0",
      "buttons": [
        {
          "label": "Лента подписок",
          "action": {
            "command": "navigation.open",
            "destination": "feed"
          }
        },
        {
          "label": "Поиск треков",
          "action": {
            "command": "navigation.open",
            "destination": "search"
          }
        }
      ]
    }
  ],
  "rules": []
}
