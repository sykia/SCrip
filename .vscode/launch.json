{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SCrip",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/scrip",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build desktop",
      "setupCommands": [
        {
          "description": "GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Do not download system debug symbols automatically",
          "text": "-gdb-set debuginfod enabled off",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
